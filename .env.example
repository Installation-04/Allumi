# Allumi — configuration. Copie vers .env (install.sh ou install-docker.sh le fait pour toi).
# Ne commit JAMAIS le fichier .env.

# --- Accès web (HTTP direct; TLS éventuel géré par votre propre proxy) ---
APP_URL=http://localhost:28080
ALLUMI_BIND_ADDRESS=0.0.0.0
ALLUMI_HTTP_PORT=28080
# Marqueur de migration réseau; ne pas modifier.
ALLUMI_NETWORK_MODE=direct

# --- Images (gérées par install-docker.sh, update.sh et up.sh : ne pas modifier à la main) ---
# Une copie placée sur une version étiquetée télécharge les images publiées (application et migrations,
# AMD64 et ARM64) au lieu de les compiler. Absentes = images construites sur place.
# ALLUMI_APP_IMAGE=ghcr.io/installation-04/allumi:0.4.0-alpha.10
# ALLUMI_MIGRATE_IMAGE=ghcr.io/installation-04/allumi-migrate:0.4.0-alpha.10

# --- Base de données ---
POSTGRES_DB=allumi
POSTGRES_USER=allumi
POSTGRES_PASSWORD=CHANGE_ME
DATABASE_URL=postgresql://allumi:CHANGE_ME@db:5432/allumi?schema=public
# Rôle restreint « allumi_app » utilisé par l'application (sans droit de contournement de la sécurité
# par ligne). Mot de passe généré par les scripts d’installation; le service migrate le configure à chaque démarrage.
APP_DB_PASSWORD=CHANGE_ME
APP_DATABASE_URL=postgresql://allumi_app:CHANGE_ME@db:5432/allumi

# --- Sécurité (générés par les scripts d’installation : openssl rand -base64 48) ---
AUTH_SECRET=CHANGE_ME
ENCRYPTION_KEY=CHANGE_ME

# --- Application ---
NODE_ENV=production
LOG_LEVEL=info
DEFAULT_LOCALE=fr-CA
# Jeton demandé par la page /setup (première configuration) : sans lui, la première personne qui
# atteint l'adresse pourrait créer l'administrateur. Généré par les scripts d’installation; vide = pas de jeton (dev).
SETUP_TOKEN=
# 0 = accès direct : ignorer les en-têtes X-Forwarded-For fournis par le client.
# Avec un proxy externe de confiance, régler le nombre de sauts et restreindre l’accès direct.
TRUSTED_PROXY_HOPS=0

# --- Courriel (SMTP) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Allumi <no-reply@exemple.ca>

# --- Sauvegardes (utilisées par scripts/backup.sh) ---
BACKUP_DIR=/var/backups/allumi
BACKUP_RETENTION_DAYS=30
# Clé publique age (recommandé) : age1...  — la clé privée reste HORS du serveur
BACKUP_AGE_RECIPIENT=
# Destination hors site (rclone), ex. : remote:allumi-backups  — laisser vide pour désactiver
BACKUP_RCLONE_REMOTE=
